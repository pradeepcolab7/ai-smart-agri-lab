# --- Database (MongoDB Atlas) ---
# Replace with your actual MongoDB Atlas connection URI:
# e.g., mongodb+srv://dbUser:yourPassword@cluster0.xxxx.mongodb.net/agri_lab?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/agri_lab?retryWrites=true&w=majority

# --- NextAuth ---
# Generated secure secret for NextAuth:
NEXTAUTH_SECRET=n+QcZ7f9rS2K8dJw3vY5xPqA1mL6nT4uB9oE2iV8yX4=
NEXTAUTH_URL=http://localhost:3000

# Optional Google OAuth for admin sign-in (Google Cloud Console > Credentials)
