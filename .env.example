# ─────────────────────────────────────────────────────────────
#  Intelligent AI & Smart Agriculture Research Lab — env config
#  Copy this file to `.env.local` (dev) or set in Vercel (prod).
# ─────────────────────────────────────────────────────────────

# --- Database (MongoDB Atlas) ---
# mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/agri_lab?retryWrites=true&w=majority
MONGODB_URI=

# --- NextAuth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Optional Google OAuth for admin sign-in (Google Cloud Console > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Seed admin (used by scripts/seed-admin.mjs). Change before deploying.
ADMIN_EMAIL=admin@agrilab.org
ADMIN_PASSWORD=change-me-strong-password

# --- Researcher identity ---
GOOGLE_SCHOLAR_ID=            # e.g. ABC123dEfGh  (the `user=` value in the Scholar profile URL)
SCOPUS_AUTHOR_ID=58710685300
ORCID_ID=0000-0003-3142-6373

# --- Publication source APIs ---
# SerpAPI (Google Scholar): https://serpapi.com/manage-api-key
SERPAPI_KEY=
# Scopus / Elsevier: https://dev.elsevier.com/  (register app -> API key)
SCOPUS_API_KEY=
SCOPUS_INST_TOKEN=            # optional, only if your institution issued one
# ORCID public API needs no key for public data.

# --- Cron protection ---
# A random secret the Vercel Cron / external scheduler sends as `?secret=` or Bearer.
CRON_SECRET=

# --- AI Research Assistant (RAG over publications) ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
